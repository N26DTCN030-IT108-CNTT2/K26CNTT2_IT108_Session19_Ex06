# ==============================================================================
# E-COMMERCE PROJECT ENVIRONMENT CONFIGURATION TEMPLATE
# (LƯU Ý: Không điền giá trị thật vào tệp này. Chép thành .env để sử dụng)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG CHUNG (APP CONFIG)
# ------------------------------------------------------------------------------
APP_NAME="ECommerceApp"
APP_ENV=development               # Giá trị khả dĩ: development | testing | production
APP_PORT=8080
LOG_LEVEL=debug                   # Giá trị khả dĩ: debug | info | warn | error

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MÔI TRƯỜNG PHÁT TRIỂN (DEVELOPMENT ENVIRONMENT)
# ------------------------------------------------------------------------------
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=5432
DEV_DB_NAME=ecommerce_dev_db
DEV_DB_USER=your_dev_db_user
DEV_DB_PASSWORD=your_dev_db_password_here

DEV_PAYMENT_GATEWAY_URL="[https://sandbox.payment.com/api/v1](https://sandbox.payment.com/api/v1)"
DEV_STRIPE_PUBLIC_KEY="pk_test_sample_key_12345"
DEV_STRIPE_SECRET_KEY="sk_test_placeholder_key_abcde"

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH MÔI TRƯỜNG KIỂM THỬ (TEST / STAGING ENVIRONMENT)
# ------------------------------------------------------------------------------
TEST_DB_HOST=staging-db.internal.net
TEST_DB_PORT=5432
TEST_DB_NAME=ecommerce_test_db
TEST_DB_USER=your_test_db_user
TEST_DB_PASSWORD=your_test_db_password_here

TEST_API_MOCK_SERVER="[https://staging-api.ecommerce.com](https://staging-api.ecommerce.com)"
TEST_MAIL_SERVER_HOST="smtp.mailtrap.io"
TEST_MAIL_SERVER_PORT=2525

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH MÔI TRƯỜNG VẬN HÀNH THỰC TẾ (PRODUCTION ENVIRONMENT)
# ------------------------------------------------------------------------------
PROD_DB_HOST=prod-cluster-db.provider.com
PROD_DB_PORT=5432
PROD_DB_NAME=ecommerce_production_db
PROD_DB_USER=your_prod_db_user
PROD_DB_PASSWORD=your_prod_db_password_here

PROD_STRIPE_PUBLIC_KEY="pk_live_placeholder_key"
PROD_STRIPE_SECRET_KEY="sk_live_placeholder_key"
PROD_AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID_HERE"
PROD_AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY_HERE"
PROD_AWS_S3_BUCKET_NAME="ecommerce-prod-media-bucket"